{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2020",
		"noImplicitAny": true,
		"moduleResolution": "node",
		"allowSyntheticDefaultImports": true,
		"isolatedModules": true,
		"strict": true,
		"noUnusedLocals": true,
		"noImplicitOverride": true,
		"lib": ["DOM", "ES2020"],
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "test/**/*.ts", "tools/**/*.ts"]
}
